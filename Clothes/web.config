<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- To customize the asp.net core module uncomment and edit the following section. 
  For more info see https://go.microsoft.com/fwlink/?linkid=838655 -->
  <!--
  <system.webServer>
    <handlers>
      <remove name="aspNetCore"/>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified"/>
    </handlers>
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
  </system.webServer>
  -->
  <system.data>
    <DbProviderFactories>
      <!-- MySQL yapılandırmasını kaldır -->
      <remove invariant="MySql.Data.MySqlClient"></remove>

      <!-- SQL Server yapılandırmasını ekleyin -->
      <add name="SqlClient Data Provider" invariant="System.Data.SqlClient" description=".Net Framework Data Provider for SQL Server" type="System.Data.SqlClient.SqlClientFactory, System.Data.SqlClient, Version=4.0.0.0, Culture=neutral" />
    </DbProviderFactories>
  </system.data>


</configuration>