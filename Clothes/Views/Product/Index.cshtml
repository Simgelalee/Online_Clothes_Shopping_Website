@model IEnumerable<ClothesApp.Models.Product>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <p>
        <a asp-action="Create"class="btn btn-primary">Ürün Ekle</a>
    </p>
    <table class="table   table-bordered" id="myTable" style="color: wheat">
        <thead>
            <tr>
                <th>
                    Resim
                </th>
                <th>
                   Başlık
                </th>
                
               
                <th>
                   Anasayfa
                </th>
                
                <th>
                   Kategori
                </th>
               
                <th>
                   Stok
                </th>
                
               
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (item.ImageUrl==null)
                        {
                            <img src="~/images/image/resim-yok.jpg" width="100" height="80" />
                        }
                        else
                        {
                            <img src="@item.ImageUrl" width="100" height="80" />
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    
                    
                    <td>
                        @if (item.IsHome)
                        {
                            <label class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i>Evet</label>
                        }
                        else
                        {
                            <label class="btn btn-danger btn-sm"><i class="bi bi-x-lg"></i>Hayır</label>
                        }
                    </td>
                    
                    <td>
                        @Html.DisplayFor(modelItem => item.Category.CategoryName)
                    </td>     
                                                
                    <td>
                        @if (item.IsActive)
                        {
                            <label class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i>Evet</label>
                        }
                        else
                        {
                            <label class="btn btn-danger btn-sm"><i class="bi bi-x-lg"></i>Hayır</label>
                        }
                    </td>
                    
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-ticket-detailed"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash">   </i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
