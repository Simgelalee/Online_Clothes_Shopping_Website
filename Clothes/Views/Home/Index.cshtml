<section>
    <div class="container">
        <div class="row justify-content-center align-items-center">
                @foreach (var item in Model)
                {
                <div class="col-md-3 mb-4">
                    <div class="card mx-auto">
                        <img src="@item.ImageUrl" class="card-img-top" />
                        <div class="info">
                            <h1><label style="font-size:20px;color:crimson"><b>@item.Price.ToString("0.00") £</b></label></h1>
                            <div class="card-header">
                                    @item.Name
                            </div>
                            <p class="card-text">@item.Description</p>
                            <button onclick="window.location.href='@Url.Action("Details", "Home", new { id = item.Id })'" class="btn btn-outline-s" style="float:right">Detay</button>
                        </div>
                    </div>
                </div>
                }
        </div>
    </div>
</section>
<script>
    function myjscode() {
        var sidebarElements = document.getElementsByClassName('sidebarasd');

        var mydiv = document.querySelector('.content');



        for (var i = 0; i < sidebarElements.length; i++) {
            var sidebar = sidebarElements[i];
            if (sidebar.style.display === 'none' || sidebar.style.display === '') {
                sidebar.style.display = 'block';
                mydiv.style.width = "100vw"

            } else {
                sidebar.style.display = 'none';
                mydiv.style.width = "95vw"
            }
        }
        var mainElements = document.getElementsByClassName('main');
        for (var i = 0; i < mainElements.length; i++) {
            var mainElement = mainElements[i];
            if (mainElement.style.overflow == 'hidden' || mainElement.style.overflow === '') {
                mainElement.style.overflow = 'visible';
            } else {
                mainElement.style.overflow = 'hidden';
            }
        }

        var contentDiv = document.querySelector('.myswipper');

        contentDiv.classList.toggle('col-md-9');


    }

</script>



