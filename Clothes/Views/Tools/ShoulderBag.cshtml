
@{
    ViewData["Title"] = "ShoulderBag";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/5.0.0/normalize.min.css">
<link rel="stylesheet" href="/disttt/style.css">

<style>
    .card {
        padding =0;
    }

    .card-wrapper {
    }
</style>



<div class="mb-5"></div>

<div id="myCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/omuz.png" class="d-block w-100" alt="...">

        </div>

    </div>

</div>

<div class="mb-5"></div>

<div id="myCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/img/şerit.png" class="d-block w-100" alt="..." height="50">>

        </div>
    </div>
</div>


<br />
<h4 class="fw-bold helvetica-neue">OMUZ ÇANTALARI</h4>


<div class="spacer"></div>
<br />

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card">
                <img src="@item.ImageUrl" class="card-img-top" />
                <div class="info">
                    <h1><label style="font-size:20px;color:crimson"><b>@item.Price.ToString("0.00") £</b></label></h1>
                    <div class="card-header">
                        @item.Name
                    </div>
                    <p class="card-text">@item.Description</p>
                    <button onclick="window.location.href='@Url.Action("Details", "Home", new { id = item.Id })'" class="btn btn-outline-s" style="float:right">Detay</button>
                </div>
            </div>
        </div>
    }
</div>