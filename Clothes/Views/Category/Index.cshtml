@model IEnumerable<ClothesApp.Models.Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
.helvetica-neue
{
    font-family: 'Helvetica Neue';
    color: white;
    text-align: center;
}

   
 </style>
<div class="container">
    <p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-bag-plus-fill"> </i>Kategori Ekle</a>
    </p>
</div>


<table class="table  table-bordered fw-bold helvetica-neue " id="myTable" >
    <thead>
        <tr>
            <th>
               Kategori Adı
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentCategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentCategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentCategoryDescription)
            </th>
          @*   <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ParentCategoryId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ParentCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ParentCategoryDescription)
            </td>
           @*  <td>
                @Html.DisplayFor(modelItem => item.ImageUrl)
            </td> *@
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="bi bi-ticket-detailed"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash">   </i></a>
            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts{
    |
    <script type= "text/javascript">

        let table = new DataTable('#myTable');

    </script>

}