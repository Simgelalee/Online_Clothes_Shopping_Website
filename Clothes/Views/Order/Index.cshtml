@using ClothesApp.Models
@model IEnumerable<ClothesApp.Models.OrderHeader>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .helvetica-neue {
        font-family: 'Helvetica Neue';
        color: white;
        text-align: center;
    }

    .dt-length label {
        color: white;
    }

    .dt-search label {
        color: white !important;
    }

    .dt-info {
        color: white !important;
    }

    .dt-paging-button {
        background: white !important;
    }

    .dt-input {
        color: white !important;
    }

        .dt-input option {
            background: white !important;
        }
</style>

<div class="btn-group d-grid gap-2 d-md-flex justify-content-md-end" role="group" aria-label="Basic outlined example">
    <a asp-action="Beklenen" asp-area="" asp-controller="Order" type="button" class="btn btn-outline-primary">Beklenen Siparişler</a>
    <a asp-action="Onaylanan" asp-area="" asp-controller="Order" type="button" class="btn btn-outline-primary">Onaylanan Siparişler</a>
    <a asp-action="Kargolanan" asp-area="" asp-controller="Order" type="button" class="btn btn-outline-primary">Kargolanan Siparişler</a>
    <a asp-action="Index" asp-area="" asp-controller="Order" type="button" class="btn btn-outline-primary active">Tüm Siparişler</a>
</div>
<br />
<div class="container">

    <table class="table table-bordered" id="myTable" style="color: wheat">
        <thead>
            <tr>
                <th>
                    Adı
                </th>
                <th>
                    Soyadı
                </th>
                <th>
                    Telefon
                </th>

                <th>
                    Durum
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        @item.Surname
                    </td>
                    <td>
                        @item.PhoneNumber
                    </td>

                    <td>
                        @item.OrderStatus
                    </td>
                    <td>
                        @if (User.IsInRole(Diger.Role_Admin))
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success"><i class="bi bi-pencil"></i> Düzenle</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success"><i class="bi bi-pencil"></i> Detay</a>
                        }



                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#myTable').DataTable({

                "language": {
                    "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Turkish.json"
                }
            });
        });
    </script>
}


